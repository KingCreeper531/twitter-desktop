{
    "name": "ranch-twitter",
    "productName": "Twitter",
    "version": "1.0.2",
    "description": "Twitter for Windows without promoted posts, Grok or Premium upsells, with the classic look",
    "main": "src/main.js",
    "author": "KingCreeper531",
    "license": "MIT",
    "private": true,
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder --win",
        "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1"
    },
    "repository": "https://github.com/KingCreeper531/twitter-desktop",
    "dependencies": {
        "@ghostery/adblocker-electron": "^2.20.3",
        "electron-updater": "^6.8.11"
    },
    "devDependencies": {
        "electron": "45.2.3",
        "electron-builder": "^26.18.0"
    },
    "build": {
        "appId": "local.ranch.twitter",
        "productName": "Twitter",
        "directories": {
            "output": "dist",
            "buildResources": "build"
        },
        "files": [
            "src/**/*",
            "build/icon.png",
            "build/badge.png",
            "package.json"
        ],
        "publish": [
            {
                "provider": "github",
                "owner": "KingCreeper531",
                "repo": "twitter-desktop",
                "releaseType": "release"
            }
        ],
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "build/icon.ico"
        },
        "nsis": {
            "artifactName": "Twitter-Setup-${version}.${ext}",
            "oneClick": true,
            "perMachine": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Twitter",
            "runAfterFinish": true
        }
    }
}
